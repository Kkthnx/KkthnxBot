# Discord bot authentication
TOKEN=your_bot_token_here
CLIENT_ID=your_application_client_id
GUILD_ID=your_kkthnxui_server_id

# MongoDB connection string
MONGO_URI=your_mongodb_uri_here

# Logging and environment
NODE_ENV=development
LOG_LEVEL=info

# Register slash commands automatically on startup (default on).
# Set to "false" to manage commands only with `npm run deploy`.
AUTO_DEPLOY=true
# Optional: channel ID that receives bot error alerts
ERROR_CHANNEL_ID=

# Role given to every new member on join. Leave blank when the /verify rules gate hands it out.
MEMBER_ROLE_ID=
ANNOUNCEMENTS_CHANNEL_ID=
MOD_LOG_CHANNEL_ID=

# GitHub. A fine-grained token with read access to KkthnxUI releases and
# read and write access to its issues. Without it, /version still works (60 calls an hour)
# but approved bug reports cannot be filed.
GITHUB_TOKEN=
# Optional overrides. Defaults are Kkthnx-Wow/KkthnxUI and the CurseForge page.
# SUPPORT_GITHUB_REPO=Kkthnx-Wow/KkthnxUI
# SUPPORT_CURSEFORGE_URL=https://www.curseforge.com/wow/addons/kkthnxui

# Release feed. New GitHub releases post in the changelog channel. Blank turns it off.
# The first run records the current release and posts nothing.
CHANGELOG_CHANNEL_ID=
# Opt-in ping roles. Full releases ping RELEASE, prereleases ping BETA. Blank means no ping.
RELEASE_PING_ROLE_ID=
BETA_PING_ROLE_ID=

# Tickets (/ticket panel). The bot needs Manage Channels.
# Category new ticket channels go in. Blank puts them at the top of the list.
TICKET_CATEGORY_ID=
# Roles that can see and close every ticket, comma separated (Moderator, Support Helper, Developer).
TICKET_STAFF_ROLE_IDS=
# Where closed-ticket transcripts go. Blank falls back to the mod-log channel.
TICKET_TRANSCRIPT_CHANNEL_ID=

# Bug reports (/bug panel). The bot needs Manage Threads in the forum.
# The bug-reports forum channel. Create tags named Retail, Classic, New, Needs Info, Filed, Fixed, Closed.
BUG_FORUM_CHANNEL_ID=
# Where GitHub issue drafts wait for approval. Blank falls back to the mod-log channel.
BUG_REVIEW_CHANNEL_ID=
# Roles that may approve a draft and file it on GitHub, comma separated (Developer, Moderator).
# Anyone with Manage Server can approve too.
BUG_APPROVER_ROLE_IDS=

# Lua error cleanup. Channels where long error pastes move into a thread, comma separated
# (lua-errors, help-retail, help-classic). Needs Manage Messages and Create Public Threads.
LUA_ERROR_CHANNEL_IDS=

# Showcase. Starred posts from this channel (show-your-ui) rotate through the welcome post.
# Needs the starboard on (/settings set starboardChannelId). Blank turns it off.
SHOWCASE_SOURCE_CHANNEL_ID=
# Hours between rotations, 1 to 24 (default 6).
# SHOWCASE_ROTATE_HOURS=6

# Optional branding overrides, handy for a test server.
# BRAND_COMMUNITY=KkthnxUI
# BRAND_BOT=KkthnxBot
# BRAND_ACCENT=#5cc8ff

# Shards to run. 1 is right until the bot nears 2,500 servers. Use "auto" to let Discord decide.
# SHARD_COUNT=1
